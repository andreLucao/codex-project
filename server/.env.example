PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Opcional: banco Prisma/local usado pela rota complementar de contatos.
DATABASE_URL=

# AI e persistencia (somente servidor; nunca use NEXT_PUBLIC_*).
OPENAI_API_KEY=your_openai_api_key
AGENT_MODEL=gpt-5.4-mini
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
RESTAURANTS_TABLE=restaurants

# Busca de fornecedores da branch integrada (Apify direto).
APIFY_TOKEN=your_apify_token

# WhatsApp Cloud API da branch integrada.
META_WHATSAPP_ACCESS_TOKEN=seu_access_token
META_WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
META_WHATSAPP_WABA_ID=seu_waba_id
META_WHATSAPP_DISPLAY_PHONE_NUMBER=+55 11 99999-9999
META_GRAPH_API_VERSION=vXX.X
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_INITIAL_RFQ_TEMPLATE_NAME=cotacao_fornecedor_entrega_v1
META_REENGAGEMENT_TEMPLATE_NAME=rfq_reengagement
META_TEMPLATE_LANGUAGE=pt_BR
META_WEBHOOK_VERIFY_TOKEN=seu_verify_token
META_APP_SECRET=seu_app_secret
META_WEBHOOK_REQUIRED=true

# Somente para demo: redireciona mensagens que iriam aos fornecedores.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_RECIPIENT_NAME=

# Regras da negociacao.
MAX_SUPPLIERS_PER_RFQ=10
MIN_QUOTES_TO_NEGOTIATE=5
MIN_QUOTES_ON_TIMEOUT=2
QUOTE_TIMEOUT_SECONDS=60
COUNTEROFFER_TIMEOUT_SECONDS=60
WHATSAPP_SERVICE_WINDOW_HOURS=24
AGENT_WORKER_INTERVAL_MS=2000
